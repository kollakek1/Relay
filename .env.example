# --- Database ---------------------------------------------------------------
# PostgreSQL connection string (Prisma Postgres, Supabase, Neon, local, ...).
# Prisma 7 uses this through the @prisma/adapter-pg driver adapter.
DATABASE_URL="postgres://user:password@localhost:5432/relay?sslmode=require"

# --- Auth (Better Auth) -----------------------------------------------------
# Public origin of the app. Used as the Better Auth base URL.
BASE_URL="http://localhost:3000"
# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Optional: expose the API base URL to the browser (rarely needed; defaults to
# the current origin).
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Email (optional) -------------------------------------------------------
# Invitations are sent by email when a provider is configured. Without these,
# Relay creates the invitation and shows the link in-app (dev flow) — mail is
# never faked as "sent".
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Relay <no-reply@your-domain.com>"

# --- Scheduled jobs ---------------------------------------------------------
# Shared secret for the cron-triggered endpoints (/api/jobs/*). Send it as
# `Authorization: Bearer <CRON_SECRET>` over HTTPS. Query-string secrets are not
# accepted. Without it the endpoints return 503 instead of pretending to run.
# Generate with: openssl rand -hex 32
# CRON_SECRET=""

# --- First administrator (seed only) ----------------------------------------
# `npm run db:seed` bootstraps the first administrator. Relay refuses to create
# an account with a missing, short or placeholder password, and never prints it.
# Required only while the account does not exist yet. Rotate + remove after the
# first production deploy.
# ROOT_EMAIL="you@your-domain.com"
# ROOT_PASSWORD=""

# Create demo content (a sample workspace + workflow). Defaults to true outside
# production; always false in production unless set to "true".
# SEED_DEMO_DATA=false

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string (Prisma Postgres, Supabase, Neon, local, ...).
# Prisma 7 uses this through the @prisma/adapter-pg driver adapter.
DATABASE_URL="postgres://user:password@localhost:5432/relay?sslmode=require"

# --- Auth (Better Auth) -----------------------------------------------------
# Public origin of the app. Used as the Better Auth base URL.
BASE_URL="http://localhost:3000"
# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Optional: expose the API base URL to the browser (rarely needed; defaults to
# the current origin).
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Seed -------------------------------------------------------------------
# Credentials for the root administrator created by `npm run db:seed`.
ROOT_EMAIL="admin@relay.com"
ROOT_PASSWORD="rootroot"

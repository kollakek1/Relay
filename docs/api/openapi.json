{
  "openapi": "3.1.0",
  "info": {
    "title": "Relay API",
    "version": "0.2.5",
    "summary": "The public REST API of Relay, the open-source workflow engine.",
    "description": "Relay exposes a versioned JSON API under /api/v1 for workflows, process instances and tasks. Every request is authenticated with a scoped API key created in the workspace settings. Responses are uniform: successful calls return { \"data\": ... } (list endpoints add a \"meta\" object), and failures return { \"error\": { \"code\", \"message\" } }.",
    "license": {
      "name": "AGPL-3.0",
      "identifier": "AGPL-3.0-only"
    },
    "x-i18n": {
      "ru": {
        "summary": "Публичный REST API Relay — открытого движка рабочих процессов.",
        "description": "Relay предоставляет версионированный JSON API по адресу /api/v1 для процессов, экземпляров и задач. Каждый запрос аутентифицируется API-ключом со scopes, созданным в настройках пространства. Формат ответов единообразен: успешные вызовы возвращают { \"data\": ... } (списочные эндпоинты добавляют объект \"meta\"), а ошибки — { \"error\": { \"code\", \"message\" } }."
      }
    }
  },
  "servers": [
    { "url": "/", "description": "The Relay instance you are connected to." }
  ],
  "tags": [
    { "name": "Workflows", "description": "Process definitions and their versions." },
    { "name": "Instances", "description": "Runs of a published workflow." },
    { "name": "Tasks", "description": "Units of work generated by a run." }
  ],
  "security": [{ "apiKey": [] }],
  "paths": {
    "/api/v1/workflows": {
      "get": {
        "tags": ["Workflows"],
        "operationId": "listWorkflows",
        "x-relay-scope": "workflows:read",
        "summary": "List workflows",
        "description": "Returns every workflow in the workspace of the authenticated key, newest updates first.",
        "x-i18n": {
          "ru": {
            "summary": "Список процессов",
            "description": "Возвращает все процессы пространства, к которому относится ключ, сначала недавно изменённые."
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Case-insensitive search over the workflow name.",
            "x-i18n": { "ru": { "description": "Поиск по названию процесса без учёта регистра." } },
            "schema": { "type": "string", "maxLength": 120 }
          }
        ],
        "responses": {
          "200": {
            "description": "The workflows in the workspace.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WorkflowList" },
                "example": {
                  "data": [
                    {
                      "id": "wf_01H",
                      "name": "Content review",
                      "description": "Draft, review and publish.",
                      "status": "PUBLISHED",
                      "steps": 3,
                      "versions": 2,
                      "instances": 5,
                      "updatedAt": "2026-10-24T12:00:00.000Z"
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/workflows/{id}/run": {
      "post": {
        "tags": ["Instances"],
        "operationId": "runWorkflow",
        "x-relay-scope": "instances:write",
        "summary": "Start a process instance",
        "description": "Starts a new instance of a published workflow. Requires the instance write scope AND the `workflow.start` permission on the account that created the key — a plain member cannot start processes unless granted it. The key acts with its owner's current role and grants, so demoting that account shrinks the key. The workflow must be published; running a draft fails with a validation error.",
        "x-i18n": {
          "ru": {
            "summary": "Запустить экземпляр процесса",
            "description": "Создаёт новый экземпляр опубликованного процесса. Требуется scope на запись экземпляров И разрешение `workflow.start` у аккаунта, создавшего ключ — обычный участник не может запускать процессы, пока ему это явно не разрешено. Ключ действует с текущей ролью и правами владельца, поэтому понижение аккаунта сужает и ключ. Процесс должен быть опубликован; запуск черновика завершается ошибкой валидации."
          }
        },
        "parameters": [{ "$ref": "#/components/parameters/WorkflowId" }],
        "responses": {
          "201": {
            "description": "The instance was created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InstanceRef" },
                "example": { "data": { "id": "inst_01H", "status": "RUNNING" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/Validation" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/instances": {
      "get": {
        "tags": ["Instances"],
        "operationId": "listInstances",
        "x-relay-scope": "instances:read",
        "summary": "List recent process runs",
        "description": "Returns the most recent runs in the workspace with their task counts.",
        "x-i18n": {
          "ru": {
            "summary": "Список последних запусков",
            "description": "Возвращает последние запуски пространства с количеством задач."
          }
        },
        "responses": {
          "200": {
            "description": "Recent instances.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InstanceList" },
                "example": {
                  "data": [
                    {
                      "id": "inst_01H",
                      "workflow": "Content review",
                      "version": 2,
                      "status": "RUNNING",
                      "tasks": 3,
                      "completedTasks": 1,
                      "startedBy": "Ada Lovelace",
                      "startedAt": "2026-10-24T12:00:00.000Z"
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/tasks": {
      "get": {
        "tags": ["Tasks"],
        "operationId": "listTasks",
        "x-relay-scope": "tasks:read",
        "summary": "List tasks",
        "description": "Paginated, filterable list of tasks in the workspace. Invalid filter values are rejected with a validation error.",
        "x-i18n": {
          "ru": {
            "summary": "Список задач",
            "description": "Постраничный список задач пространства с фильтрами. Неверные значения фильтров отклоняются с ошибкой валидации."
          }
        },
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Filter by task status.",
            "x-i18n": { "ru": { "description": "Фильтр по статусу задачи." } },
            "schema": {
              "type": "string",
              "enum": ["BLOCKED", "PENDING", "CLAIMED", "IN_PROGRESS", "DONE", "CANCELLED"]
            }
          },
          {
            "name": "kind",
            "in": "query",
            "description": "TASK for human work, APPROVAL for a decision step.",
            "x-i18n": { "ru": { "description": "TASK — работа человека, APPROVAL — шаг согласования." } },
            "schema": { "type": "string", "enum": ["TASK", "APPROVAL"] }
          },
          {
            "name": "assignee",
            "in": "query",
            "description": "Restrict to the caller's tasks, unassigned tasks, or all tasks.",
            "x-i18n": { "ru": { "description": "Ограничить своими задачами, неназначенными или всеми." } },
            "schema": { "type": "string", "enum": ["me", "unassigned", "all"], "default": "all" }
          },
          {
            "name": "priority",
            "in": "query",
            "description": "Filter by priority.",
            "x-i18n": { "ru": { "description": "Фильтр по приоритету." } },
            "schema": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"] }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Case-insensitive search over the task name.",
            "x-i18n": { "ru": { "description": "Поиск по названию задачи без учёта регистра." } },
            "schema": { "type": "string", "maxLength": 120 }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort field.",
            "x-i18n": { "ru": { "description": "Поле сортировки." } },
            "schema": { "type": "string", "enum": ["createdAt", "dueAt", "priority"], "default": "createdAt" }
          },
          {
            "name": "direction",
            "in": "query",
            "description": "Sort direction.",
            "x-i18n": { "ru": { "description": "Направление сортировки." } },
            "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" }
          },
          {
            "name": "page",
            "in": "query",
            "description": "1-based page number.",
            "x-i18n": { "ru": { "description": "Номер страницы, начиная с 1." } },
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of tasks.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TaskList" },
                "example": {
                  "data": [
                    {
                      "id": "task_01H",
                      "name": "Review the draft",
                      "status": "PENDING",
                      "kind": "TASK",
                      "priority": "HIGH",
                      "assignee": null,
                      "dueAt": "2026-10-26T12:00:00.000Z",
                      "workflow": "Content review",
                      "createdAt": "2026-10-24T12:00:00.000Z"
                    }
                  ],
                  "meta": { "total": 12, "page": 1, "pageSize": 20 }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/Validation" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "operationId": "getTask",
        "x-relay-scope": "tasks:read",
        "summary": "Get a task",
        "description": "Returns one task with its process context. A task from another workspace resolves to 404.",
        "x-i18n": {
          "ru": {
            "summary": "Получить задачу",
            "description": "Возвращает задачу вместе с контекстом процесса. Задача из другого пространства даёт 404."
          }
        },
        "parameters": [{ "$ref": "#/components/parameters/TaskId" }],
        "responses": {
          "200": {
            "description": "The task.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TaskDetail" },
                "example": {
                  "data": {
                    "id": "task_01H",
                    "name": "Review the draft",
                    "description": "Read it carefully.",
                    "status": "PENDING",
                    "kind": "TASK",
                    "priority": "HIGH",
                    "decision": null,
                    "formValues": null,
                    "dueAt": "2026-10-26T12:00:00.000Z",
                    "assignee": null,
                    "instance": { "id": "inst_01H", "status": "RUNNING" },
                    "workflow": "Content review",
                    "createdAt": "2026-10-24T12:00:00.000Z"
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/tasks/{id}/claim": {
      "post": {
        "tags": ["Tasks"],
        "operationId": "claimTask",
        "x-relay-scope": "tasks:write",
        "summary": "Claim a task",
        "description": "Atomically claims a free task for the account behind the API key. If another caller wins the race the request fails with a conflict.",
        "x-i18n": {
          "ru": {
            "summary": "Взять задачу",
            "description": "Атомарно закрепляет свободную задачу за аккаунтом API-ключа. Если задачу успел взять другой, запрос завершается конфликтом."
          }
        },
        "parameters": [{ "$ref": "#/components/parameters/TaskId" }],
        "responses": {
          "200": {
            "description": "The task is now claimed.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TaskRef" },
                "example": { "data": { "id": "task_01H", "status": "CLAIMED" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "A Relay API key (prefix rk_) sent as `Authorization: Bearer <key>`. Keys are shown once at creation and stored only as a hash.",
        "x-i18n": {
          "ru": {
            "description": "API-ключ Relay (префикс rk_) в заголовке `Authorization: Bearer <ключ>`. Ключ показывается один раз при создании и хранится только в виде хеша."
          }
        }
      }
    },
    "parameters": {
      "WorkflowId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The workflow identifier.",
        "x-i18n": { "ru": { "description": "Идентификатор процесса." } },
        "schema": { "type": "string" }
      },
      "TaskId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The task identifier.",
        "x-i18n": { "ru": { "description": "Идентификатор задачи." } },
        "schema": { "type": "string" }
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "description": "A stable, machine-readable error code.",
                "enum": ["unauthorized", "forbidden", "not_found", "conflict", "validation", "rate_limited", "internal"]
              },
              "message": { "type": "string" }
            }
          }
        }
      },
      "WorkflowSummary": {
        "type": "object",
        "required": ["id", "name", "status", "steps", "versions", "instances", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["DRAFT", "PUBLISHED", "ARCHIVED"] },
          "steps": { "type": "integer" },
          "versions": { "type": "integer" },
          "instances": { "type": "integer" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "WorkflowList": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/WorkflowSummary" } } }
      },
      "InstanceSummary": {
        "type": "object",
        "required": ["id", "workflow", "version", "status", "tasks", "completedTasks", "startedBy", "startedAt"],
        "properties": {
          "id": { "type": "string" },
          "workflow": { "type": "string" },
          "version": { "type": "integer" },
          "status": { "type": "string", "enum": ["RUNNING", "COMPLETED", "CANCELLED"] },
          "tasks": { "type": "integer" },
          "completedTasks": { "type": "integer" },
          "startedBy": { "type": "string" },
          "startedAt": { "type": "string", "format": "date-time" }
        }
      },
      "InstanceList": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/InstanceSummary" } } }
      },
      "InstanceRef": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string" },
              "status": { "type": "string", "enum": ["RUNNING", "COMPLETED", "CANCELLED"] }
            }
          }
        }
      },
      "TaskSummary": {
        "type": "object",
        "required": ["id", "name", "status", "kind", "priority", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["BLOCKED", "PENDING", "CLAIMED", "IN_PROGRESS", "DONE", "CANCELLED"]
          },
          "kind": { "type": "string", "enum": ["TASK", "APPROVAL"] },
          "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"] },
          "assignee": { "type": ["string", "null"] },
          "dueAt": { "type": ["string", "null"], "format": "date-time" },
          "workflow": { "type": ["string", "null"] },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "TaskList": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/TaskSummary" } },
          "meta": {
            "type": "object",
            "required": ["total", "page", "pageSize"],
            "properties": {
              "total": { "type": "integer" },
              "page": { "type": "integer" },
              "pageSize": { "type": "integer" }
            }
          }
        }
      },
      "TaskDetail": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "allOf": [{ "$ref": "#/components/schemas/TaskSummary" }],
            "type": "object",
            "properties": {
              "description": { "type": ["string", "null"] },
              "decision": {
                "type": ["string", "null"],
                "enum": ["APPROVED", "REJECTED", "CHANGES_REQUESTED", null]
              },
              "formValues": { "type": ["object", "null"], "additionalProperties": true },
              "assignee": {
                "type": ["object", "null"],
                "properties": { "id": { "type": "string" }, "name": { "type": "string" } }
              },
              "instance": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "status": { "type": "string", "enum": ["RUNNING", "COMPLETED", "CANCELLED"] }
                }
              }
            }
          }
        }
      },
      "TaskRef": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["BLOCKED", "PENDING", "CLAIMED", "IN_PROGRESS", "DONE", "CANCELLED"]
              }
            }
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "The API key is missing, malformed, revoked or unknown.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "example": { "error": { "code": "unauthorized", "message": "Invalid or revoked API key" } }
          }
        }
      },
      "Forbidden": {
        "description": "The key lacks the scope required by this endpoint.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "example": {
              "error": { "code": "forbidden", "message": "This key is missing the \"tasks:write\" scope" }
            }
          }
        }
      },
      "NotFound": {
        "description": "The resource does not exist in the key's workspace.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "example": { "error": { "code": "not_found", "message": "Resource not found" } }
          }
        }
      },
      "Conflict": {
        "description": "The resource was modified by someone else (for example, a task was claimed first).",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "example": {
              "error": { "code": "conflict", "message": "This task was already claimed" }
            }
          }
        }
      },
      "Validation": {
        "description": "The request was understood but the input is invalid.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "example": { "error": { "code": "validation", "message": "Invalid query parameters" } }
          }
        }
      },
      "RateLimited": {
        "description": "The per-key rate limit was exceeded. Retry after a short delay.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "example": {
              "error": { "code": "rate_limited", "message": "Too many requests. Please try again shortly." }
            }
          }
        }
      }
    }
  },
  "x-relay-webhooks": {
    "description": "Domain events Relay delivers to registered endpoints as HMAC-SHA256 signed POST requests, at least once, through a transactional outbox with retries and a dead-letter state.",
    "x-i18n": {
      "ru": {
        "description": "Доменные события, которые Relay доставляет на зарегистрированные эндпоинты подписанными HMAC-SHA256 POST-запросами — минимум один раз, через transactional outbox с повторами и состоянием dead-letter."
      }
    },
    "headers": {
      "x-relay-event": "The event name.",
      "x-relay-delivery": "A stable delivery id, used for deduplication.",
      "x-relay-timestamp": "Unix seconds used in the signature.",
      "x-relay-signature": "t=<unix>,v1=<hex hmac-sha256 of \"<t>.<raw body>\">"
    },
    "events": [
      "task.created",
      "task.claimed",
      "task.completed",
      "task.decided",
      "instance.started",
      "instance.completed",
      "workflow.published"
    ]
  }
}

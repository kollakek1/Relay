enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InstanceStatus {
  RUNNING
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  BLOCKED
  PENDING
  CLAIMED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Execution node kind. `TASK` is human work; `APPROVAL` is a decision step.
enum StepKind {
  TASK
  APPROVAL
}

/// How an approval step resolves when several people are eligible to decide.
/// `ANY` — the first decision wins. `ALL` — every eligible approver must decide.
enum ApprovalMode {
  ANY
  ALL
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ActivityType {
  CREATED
  CLAIMED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  DUE_CHANGED
  COMMENTED
  DECIDED
  REOPENED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_CLAIMED
  TASK_COMPLETED
  TASK_COMMENTED
  WORKFLOW_PUBLISHED
  INSTANCE_STARTED
  ORG_INVITATION
  TASK_DUE_SOON
  TASK_OVERDUE
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  AUTOMATION_NOTIFICATION
}

model Workflow {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  status         WorkflowStatus @default(DRAFT)
  createdById    String
  createdBy      User           @relation("WorkflowCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  steps     WorkflowStep[]
  versions  WorkflowVersion[]
  instances ProcessInstance[]

  @@index([organizationId, status])
  @@map("workflow")
}

model WorkflowStep {
  id           String    @id @default(cuid())
  workflowId   String
  workflow     Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  order        Int
  name         String
  description  String?
  assigneeRole OrgRole?
  dueInDays    Int?
  kind         StepKind  @default(TASK)
  /// Approval resolution mode; only meaningful for APPROVAL steps.
  approvalMode ApprovalMode?
  /// Form field definitions (see WorkflowFormField in the engine).
  fields       Json?
  /// Optional skip condition evaluated against collected process variables.
  condition    Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([workflowId, order])
  @@index([workflowId])
  @@map("workflow_step")
}

/// Immutable snapshot of a workflow's steps captured at publish time.
/// Active instances always reference a version, so editing the draft never
/// mutates a running process.
model WorkflowVersion {
  id            String    @id @default(cuid())
  workflowId    String
  workflow      Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version       Int
  steps         Json
  publishedById String
  publishedBy   User      @relation("VersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  publishedAt   DateTime  @default(now())

  instances ProcessInstance[]

  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("workflow_version")
}

model ProcessInstance {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId     String
  workflow       Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  versionId      String
  version        WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  status         InstanceStatus @default(RUNNING)
  startedById    String
  startedBy      User           @relation("InstanceStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  /// Set when a finished instance is archived (a reversible soft delete). An
  /// archived instance is hidden from active lists but its tasks, comments,
  /// activity, notifications, outbox events and audit trail are preserved.
  archivedAt     DateTime?
  archivedById   String?
  archivedBy     User?          @relation("InstanceArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  tasks Task[]

  @@index([organizationId, status])
  @@index([organizationId, archivedAt])
  @@index([workflowId])
  @@map("process_instance")
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instanceId     String
  instance       ProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepOrder      Int
  name           String
  description    String?
  status         TaskStatus   @default(PENDING)
  priority       TaskPriority @default(MEDIUM)
  kind           StepKind     @default(TASK)
  /// Final decision for an APPROVAL task once resolved.
  decision       ApprovalDecision?
  decisionNote   String?
  /// Minimum organization role allowed to claim this task (from the step).
  requiredRole   OrgRole?
  /// Form field definitions captured from the step at instance start.
  fields         Json?
  /// Submitted form values (validated server-side before completion).
  formValues     Json?
  /// Free-form labels for filtering and reporting.
  tags           String[]     @default([])
  /// Users who receive updates about this task without being the assignee.
  observerIds    String[]     @default([])
  /// Another task that must be DONE before this one can be claimed.
  blockedByTaskId String?
  blockedBy      Task?        @relation("TaskDependency", fields: [blockedByTaskId], references: [id], onDelete: SetNull)
  blocks         Task[]       @relation("TaskDependency")
  assigneeId     String?
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User         @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  dueAt          DateTime?
  claimedAt      DateTime?
  completedAt    DateTime?
  /// Reason recorded when a task is cancelled (e.g. skipped by a condition).
  cancelReason   String?
  /// Incremented on every claim to make the pool claim atomic (optimistic lock).
  claimVersion   Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  activities TaskActivity[]
  comments   Comment[]
  decisions  TaskDecision[]

  @@index([organizationId, status, createdAt])
  @@index([assigneeId, status])
  @@index([instanceId])
  @@map("task")
}

/// A single actor's vote on an approval task. `ALL` mode is satisfied only when
/// every eligible approver has a row here.
model TaskDecision {
  id        String           @id @default(cuid())
  taskId    String
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation("TaskDecisionActor", fields: [userId], references: [id], onDelete: Cascade)
  decision  ApprovalDecision
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([taskId, userId])
  @@index([taskId])
  @@map("task_decision")
}

model TaskActivity {
  id        String       @id @default(cuid())
  taskId    String
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      ActivityType
  fromValue String?
  toValue   String?
  createdAt DateTime     @default(now())

  @@index([taskId, createdAt])
  @@map("task_activity")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
  @@map("comment")
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  body           String?
  link           String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId, readAt])
  @@index([organizationId])
  @@map("notification")
}

/// A reusable workflow definition. `organizationId = null` means a built-in
/// template available to every workspace; otherwise it is a workspace template
/// saved from an existing process.
model WorkflowTemplate {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  category       String?
  steps          Json
  createdById    String?
  createdBy      User?         @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@map("workflow_template")
}
